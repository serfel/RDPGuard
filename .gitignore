```gitignore
# Compiled and build artifacts
*.obj
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.lib
*.so
*.dylib
*.class
*.pyc
__pycache__/
*.o
*.a
*.out

# Dependencies
node_modules/
.venv/
venv/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo
*.bak
*.~*

# Coverage reports
coverage/
htmlcov/
.coverage

# Build outputs
build/
dist/
target/
bin/
obj/

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
```